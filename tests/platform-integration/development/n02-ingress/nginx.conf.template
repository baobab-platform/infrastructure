# IAM-N02 disposable DEVELOPMENT ONLY. Render through n02_ingress.py.
# No live certificate, workload credential, CP grant, production ingress or
# provider activation belongs in this repository.
worker_processes 1;
events { worker_connections 128; }
http {
    server_tokens off;
    client_max_body_size 1m;
    proxy_read_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_send_timeout 15s;

    # Reject unreviewed Host/SNI before route selection.
    server {
        listen 443 ssl default_server;
        ssl_reject_handshake on;
    }

    server {
        listen 443 ssl;
        server_name __N02_FIRST_PARTY_FQDN__;
        if ($host != __N02_FIRST_PARTY_FQDN__) { return 421; }
        ssl_certificate /run/n02-private/edge/fullchain.pem;
        ssl_certificate_key /run/n02-private/edge/private-key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;

        # The Go BFF rejects plaintext r.TLS, checks r.Host and exact Origin.
        # Path and Host remain unchanged. Only a CA-verified TLS upstream can
        # receive its host-only BFF transaction/session cookies.
        location ^~ /auth/ {
            proxy_pass https://127.0.0.1:9443;
            proxy_ssl_server_name on;
            proxy_ssl_name __N02_FIRST_PARTY_FQDN__;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_ssl_trusted_certificate /run/n02-private/upstream-roots.pem;
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 2;
            proxy_ssl_session_reuse off;
            proxy_set_header Host __N02_FIRST_PARTY_FQDN__;
            proxy_set_header X-Forwarded-Host __N02_FIRST_PARTY_FQDN__;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_redirect off;
            proxy_buffering off;
        }

        # Kratos public MUST be on the same browser origin. Host-only
        # ory_kratos_session is sent back to /auth/login and /auth/consent.
        # Kratos Admin (4434) MUST NOT be published on this ingress.
        location ^~ /self-service/ {
            proxy_pass https://127.0.0.1:9444;
            proxy_ssl_server_name on;
            proxy_ssl_name __N02_FIRST_PARTY_FQDN__;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_ssl_trusted_certificate /run/n02-private/upstream-roots.pem;
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 2;
            proxy_set_header Host __N02_FIRST_PARTY_FQDN__;
            proxy_set_header X-Forwarded-Host __N02_FIRST_PARTY_FQDN__;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_redirect off;
            proxy_buffering off;
        }
        location = /sessions/whoami {
            proxy_pass https://127.0.0.1:9444;
            proxy_ssl_server_name on;
            proxy_ssl_name __N02_FIRST_PARTY_FQDN__;
            proxy_ssl_protocols TLSv1.2 TLSv1.3;
            proxy_ssl_trusted_certificate /run/n02-private/upstream-roots.pem;
            proxy_ssl_verify on;
            proxy_ssl_verify_depth 2;
            proxy_set_header Host __N02_FIRST_PARTY_FQDN__;
            proxy_set_header X-Forwarded-Host __N02_FIRST_PARTY_FQDN__;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_redirect off;
            proxy_buffering off;
        }

        # Never expose issuer/CP/Kratos admin or private document routes.
        location ^~ /admin/ { return 404; }
        location ^~ /internal/ { return 404; }
        location ^~ /oauth2/ { return 404; }
        location ^~ /.git/ { return 404; }

        # Existing Next /api/iam/* remains ESTATE-owned, not a Go BFF
        # alias. Next is same-machine private loopback; browser stays HTTPS.
        location / {
            proxy_pass http://127.0.0.1:3000;
            proxy_set_header Host __N02_FIRST_PARTY_FQDN__;
            proxy_set_header X-Forwarded-Host __N02_FIRST_PARTY_FQDN__;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For "";
            proxy_redirect off;
        }
    }
}
