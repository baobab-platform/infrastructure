# Local-only credentials and Compose state
compose/.env
compose/*.override.yaml

# Terraform state must never be committed when Terraform is introduced.
*.tfstate
*.tfstate.*
.terraform/


# INT-01 transient private service environment and scrubbed evidence
/tests/platform-integration/.runtime/*
!/tests/platform-integration/.runtime/.gitignore
/tests/platform-integration/evidence/*
!/tests/platform-integration/evidence/.gitignore
